# Set production secrets outside source control.
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
OTP_SECRET=replace-with-a-separate-random-secret
# SQLite works locally without a separate database server.
# For Docker Compose, the DATABASE_URL is configured in docker-compose.yml.
DATABASE_URL=sqlite:///./vegz.db
ACCESS_TOKEN_MINUTES=10080
OTP_TTL_MINUTES=5
# Set OTP_PROVIDER=sns to send real test OTPs through AWS SNS.
# Use AWS_REGION plus AWS credentials from your shell or an attached IAM role.
OTP_PROVIDER=demo
AWS_REGION=ap-south-1
SNS_SMS_TYPE=Transactional
OTP_MESSAGE_TEMPLATE=Your Vegz verification code is {otp}. It expires in {minutes} minutes. Do not share this code.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://vegz.online,https://www.vegz.online
DELIVERY_FEE=25
FREE_DELIVERY_MINIMUM=499
